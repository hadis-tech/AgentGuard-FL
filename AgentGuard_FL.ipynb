## Step 4 — Models

**AgentGuard model.** Pseudo-tokens → shared trainable embedding W_emb (+ bias) → m soft prompts
prepended (Eq. 16) → BERT-Tiny encoder → mean pooling → classifier W_last. The encoder's own
position embeddings tell it which feature each token is. `backbone_mode`:
* `pretrained_frozen` — the paper's design; only W_emb, b_emb, S, W_last are trained and sent.
* `random_frozen` — same architecture, random frozen encoder (does pretraining matter?).
* `scratch_trainable` — same architecture trained from scratch, encoder sent every round.

**Other models.** `mlp` (a plain MLP on the standardised features, usable with any defence)
and the Table III baselines FL-CNN / FL-RNN / FL-LSTM (feature vector read as a sequence).
Replace these with the exact architectures of your references if they differ.
class AgentGuardTinyBERT(nn.Module):
    input_kind = "tokens"

    def __init__(self, n_features: int, cfg: Config):
        super().__init__()
        from transformers import BertConfig, BertModel
        if cfg.backbone_mode == "pretrained_frozen":
            self.encoder = BertModel.from_pretrained(cfg.backbone_name, add_pooling_layer=False)
        elif cfg.backbone_mode in ("random_frozen", "scratch_trainable"):
            # vocab_size=2: the word-embedding table is never used (we pass inputs_embeds)
            self.encoder = BertModel(BertConfig(vocab_size=2, hidden_size=128, num_hidden_layers=2,
                                                num_attention_heads=2, intermediate_size=512,
                                                max_position_embeddings=512), add_pooling_layer=False)
        else:
            raise ValueError(cfg.backbone_mode)
        d_model = self.encoder.config.hidden_size
        if cfg.n_prompts + n_features > self.encoder.config.max_position_embeddings:
            raise ValueError("n_prompts + n_features exceeds the backbone's maximum sequence length.")
        trainable_encoder = cfg.backbone_mode == "scratch_trainable"
        for name, p in self.encoder.named_parameters():
            p.requires_grad_(trainable_encoder and "word_embeddings" not in name)

        self.feature_embedding = nn.Embedding(cfg.n_bins, d_model)   # W_emb (Eq. 15)
        self.feature_bias = nn.Parameter(torch.zeros(d_model))       # b_emb
        nn.init.normal_(self.feature_embedding.weight, std=0.02)
        self.soft_prompts = nn.Parameter(torch.randn(cfg.n_prompts, d_model) * 0.02)  # S
        self.classifier = nn.Linear(d_model, 2)                      # W_last

    def train(self, mode: bool = True):
        super().train(mode)
        self.encoder.eval()            # no dropout in the encoder in any mode
        return self

    def forward(self, tokens):
        e = self.feature_embedding(tokens) + self.feature_bias
        s = self.soft_prompts.unsqueeze(0).expand(tokens.size(0), -1, -1)
        h = self.encoder(inputs_embeds=torch.cat([s, e], dim=1)).last_hidden_state
        return self.classifier(h.mean(dim=1))


class MLP(nn.Module):
    input_kind = "float"

    def __init__(self, n_features: int, hidden: int = 128):
        super().__init__()
        self.net = nn.Sequential(nn.Linear(n_features, hidden), nn.ReLU(),
                                 nn.Linear(hidden, hidden), nn.ReLU(), nn.Linear(hidden, 2))

    def forward(self, x):
        return self.net(x)


class SeqBaseline(nn.Module):
    input_kind = "float"

    def __init__(self, n_features: int, kind: str, hidden: int = 64):
        super().__init__()
        self.kind = kind
        if kind == "cnn":
            self.body = nn.Sequential(nn.Conv1d(1, 32, 5, padding=2), nn.ReLU(),
                                      nn.Conv1d(32, 64, 5, padding=2), nn.ReLU(),
                                      nn.AdaptiveMaxPool1d(1), nn.Flatten())
            out = 64
        else:
            self.body = (nn.RNN if kind == "rnn" else nn.LSTM)(1, hidden, batch_first=True)
            out = hidden
        self.head = nn.Linear(out, 2)

    def forward(self, x):
        if self.kind == "cnn":
            return self.head(self.body(x.unsqueeze(1)))
        out, _ = self.body(x.unsqueeze(-1))
        return self.head(out[:, -1])


def make_model(kind: str, n_features: int, cfg: Config, device: str) -> nn.Module:
    if kind == "tinybert":
        m = AgentGuardTinyBERT(n_features, cfg)
    elif kind == "mlp":
        m = MLP(n_features)
    else:
        m = SeqBaseline(n_features, kind)
    return m.to(device)


def get_trainable(model) -> Dict[str, torch.Tensor]:
    return {n: p.detach().cpu().clone() for n, p in model.named_parameters() if p.requires_grad}


def set_trainable(model, state):
    with torch.no_grad():
        for n, p in model.named_parameters():
            if n in state:
                p.copy_(state[n].to(p.device))


def flat(d) -> torch.Tensor:
    return torch.cat([v.flatten() for v in d.values()])


def unflat(vec, like):
    out, i = {}, 0
    for k, v in like.items():
        out[k] = vec[i:i + v.numel()].view_as(v).clone().to(v.dtype)
        i += v.numel()
    return out


def to_input(X, model, device):
    if model.input_kind == "tokens":
        return torch.as_tensor(X.astype(np.int64), device=device)
    return torch.as_tensor(X, dtype=torch.float32, device=device)


@torch.no_grad()
def predict_logits(model, X, device, bs=2048) -> torch.Tensor:
    model.eval()
    out = [model(to_input(X[s:s + bs], model, device)).float().cpu() for s in range(0, len(X), bs)]
    return torch.cat(out) if out else torch.zeros(0, 2)


def predict_attack_proba(model, X, device) -> np.ndarray:
    return F.softmax(predict_logits(model, X, device), dim=1)[:, 1].numpy()


def val_acc_loss(model, X, y, device):
    if len(y) == 0:
        return 0.0, float("inf")
    logits = predict_logits(model, X, device)
    return float((logits.argmax(1).numpy() == y).mean()), F.cross_entropy(logits, torch.as_tensor(y)).item()
## Step 5 — Attacks

* **CA-LFA** (Algorithm 1): top-ρ attack samples by global-model confidence flipped to normal,
  recomputed each round; poisoned update projected to norm τ_a.
* **RLFA**: a random ρ fraction of attack samples flipped to normal (static poisoned dataset).
* **ALIE** (Baruch et al., NeurIPS 2019, "A Little Is Enough"): a model-poisoning attack that does
  *not* touch labels. Colluding attackers estimate the coordinate-wise mean μ and std σ of benign
  updates and all submit μ − z·σ, a shift small enough to hide inside normal client variation.
  z = Φ⁻¹((n − s)/n) with s = ⌊n/2 + 1⌋ − f; for n = 10, f = 4 this gives z ≈ 0.84. Because the
  labels stay clean, AgentGuard's label-consistency signal cannot see it, so it tests the defence
  beyond the attack it was designed for (R3-5).
def calfa_flip(p_attack, y, rho):
    y_t = y.copy()
    att = np.where(y == 1)[0]
    if len(att) == 0 or rho <= 0:
        return y_t
    k = int(np.ceil(rho * len(att)))
    y_t[att[np.argsort(-p_attack[att], kind="stable")[:k]]] = 0      # Eqs. 3–5
    return y_t


def rlfa_flip(y, rho, rng, mode="attack_to_normal"):
    y_t = y.copy()
    pool = np.where(y == 1)[0] if mode == "attack_to_normal" else np.arange(len(y))
    if len(pool) == 0 or rho <= 0:
        return y_t
    chosen = rng.choice(pool, size=int(np.ceil(rho * len(pool))), replace=False)
    y_t[chosen] = 0 if mode == "attack_to_normal" else 1 - y_t[chosen]
    return y_t


def alie_z(n: int, f: int) -> float:
    s = n // 2 + 1 - f
    return float(_normal.ppf((n - max(s, 1)) / n))


def norm_project(delta, budget):
    n = flat(delta).norm().item()
    scale = min(1.0, budget / (n + 1e-12))
    return {k: v * scale for k, v in delta.items()}


ATTACK_NAMES = {"none": "No attack", "ca_lfa": "CA-LFA", "rlfa": "RLFA", "alie": "ALIE"}
## Step 6 — Local training and the AgentGuard-FL client agent (Algorithm 2, lines 2–16)
def local_train(model, X, y, cfg, device, epochs, lr, batch_size, rng,
                reliability=None, X_val=None, y_val=None, early_stop=False):
    """Class-weighted (Eq. 17), optionally reliability-weighted (Eq. 20) cross-entropy.
    Weighted mean (Σw·ℓ / Σw): relative sample weights are exactly those of Eqs. 17/20."""
    n = len(y)
    if n == 0:
        return
    w = (n / np.maximum(1, np.bincount(y, minlength=2)))[y]
    if reliability is not None:
        w = w * reliability
    w_t, y_t = torch.as_tensor(w, dtype=torch.float32), torch.as_tensor(y)
    params = [p for p in model.parameters() if p.requires_grad]
    opt = torch.optim.Adam(params, lr=lr)
    prev_loss, worse = float("inf"), 0
    for _ in range(epochs):
        model.train()
        perm = rng.permutation(n)
        for s in range(0, n, batch_size):
            idx = perm[s:s + batch_size]
            xb = to_input(X[idx], model, device)
            yb, wb = y_t[idx].to(device), w_t[idx].to(device)
            loss = (F.cross_entropy(model(xb), yb, reduction="none") * wb).sum() / (wb.sum() + 1e-12)
            opt.zero_grad()
            loss.backward()
            if cfg.grad_clip_norm > 0:
                torch.nn.utils.clip_grad_norm_(params, cfg.grad_clip_norm)
            opt.step()
        if early_stop and y_val is not None and len(y_val) > 0:               # Eq. 27
            _, vl = val_acc_loss(model, X_val, y_val, device)
            worse = worse + 1 if vl > prev_loss else 0
            prev_loss = vl
            if worse >= 2:
                for g in opt.param_groups:
                    g["lr"] *= 0.5
                break


def client_round(model, theta_g, X_tr, y_tr, X_va, y_va, *, defence, is_mal, attack, rho,
                 rlfa_labels, cfg, device, rng, rnd=1):
    """One client, one round. Returns (update, telemetry, n_i, n_flipped).
    ALIE attackers train honestly here; their crafted update is substituted in run_experiment."""
    set_trainable(model, theta_g)
    y_tr0 = y_tr

    # (1) Label poisoning (Algorithm 1, lines 1–4)
    p_tr = None
    if is_mal and attack == "ca_lfa":
        p_tr = predict_attack_proba(model, X_tr, device)
        y_tr = calfa_flip(p_tr, y_tr, rho)
        y_va = calfa_flip(predict_attack_proba(model, X_va, device), y_va, rho)
    elif is_mal and attack == "rlfa":
        y_tr, y_va = rlfa_labels
    n_flipped = int((y_tr != y_tr0).sum())

    runs_agent = defence == "agentguard" and (not is_mal or cfg.attacker_runs_agent)
    if runs_agent:                                           # pre-flight validation
        ok = np.isin(y_tr, [0, 1])
        X_tr, y_tr = X_tr[ok], y_tr[ok]
        p_tr = p_tr[ok] if p_tr is not None else None
    n = len(y_tr)
    if n == 0:
        zero = {k: torch.zeros_like(v) for k, v in theta_g.items()}
        return zero, dict(n=0, acc=0.0, loss=float("inf"), clip=0, z=0, mu=1.0), 0, n_flipped

    # (2) Label consistency (Eqs. 18, 19, 21)
    mu, rel = 0.0, None
    if defence == "agentguard":
        if p_tr is None:
            p_tr = predict_attack_proba(model, X_tr, device)
        q = np.abs(y_tr - p_tr)
        mu = float(np.mean(q >= cfg.gamma_q))
        if runs_agent and cfg.use_reliability and rnd > cfg.defence_warmup_rounds:
            rel = np.maximum(cfg.r_min, 1.0 - q)

    # (3) Local training
    if runs_agent:
        full = n >= cfg.light_plan_min_samples
        epochs, bs = (cfg.local_epochs, cfg.batch_size) if full else (1, min(cfg.batch_size, cfg.batch_min))
        local_train(model, X_tr, y_tr, cfg, device, epochs, cfg.lr, bs, rng,
                    reliability=rel, X_val=X_va, y_val=y_va, early_stop=True)
    else:
        local_train(model, X_tr, y_tr, cfg, device, cfg.local_epochs, cfg.lr, cfg.batch_size, rng)

    theta_local = get_trainable(model)
    delta = {k: theta_local[k] - theta_g[k] for k in theta_g}
    raw_norm = flat(delta).norm().item()

    # (4) Post-processing
    if runs_agent:
        clip_flag = int(raw_norm > cfg.tau)                                      # Eq. 31
        if cfg.use_clipping:
            delta = norm_project(delta, cfg.tau)                                 # Eq. 29
        if cfg.sigma > 0:
            delta = {k: v + torch.randn_like(v) * cfg.sigma for k, v in delta.items()}  # Eq. 30
    else:
        if is_mal and attack == "ca_lfa" and cfg.calfa_norm_projection:
            delta = norm_project(delta, cfg.tau_a)                               # Eq. 9
        clip_flag = int(flat(delta).norm().item() > cfg.tau)

    # (5) Telemetry (Eqs. 32–33)
    tele = None
    if defence == "agentguard":
        acc, loss = val_acc_loss(model, X_va, y_va, device)
        tele = dict(n=n, acc=acc, loss=loss, clip=clip_flag,
                    z=int(acc >= cfg.gamma_acc and loss <= cfg.gamma_loss), mu=mu)
    return delta, tele, n, n_flipped
## Step 7 — Server aggregation

**AgentGuard-FL** (Eqs. 34–42). The update norm in Eq. 36 is computed by the server from the
received update (identical to the reported ‖Δθ̃‖ when σ = 0, but cannot be forged). Each trust
term can be switched off for the ablation.

**Krum** (Blanchard et al. 2017): picks the single update with the smallest sum of squared
distances to its n − f − 2 nearest neighbours. It requires n > 2f + 2; with 4 of 10 attackers this
fails, so f is capped at ⌊(n − 3)/2⌋ = 3 — state this in the paper.
**Trimmed Mean** (Yin et al. 2018): per coordinate, drop the f largest and f smallest values and
average the rest (f capped at ⌊(n − 1)/2⌋).

Note on non-IID data: an honest client holding mostly the class the global model currently gets
wrong has a high suspicion ratio μ and fails the sanity check, so it is down-weighted like an
attacker. Check the "AgentGuard-FL / No attack" row for each α in the heterogeneity table.
class AgentGuardServer:
    def __init__(self, n_clients, cfg):
        self.cfg = cfg
        self.R = np.full(n_clients, cfg.R0, dtype=np.float64)

    def aggregate(self, theta_g, cids, deltas, teles, rnd=1):
        c = self.cfg
        use_trust = c.use_trust and rnd > c.defence_warmup_rounds
        U = torch.stack([flat(d) for d in deltas]).double()
        norms = U.norm(dim=1).numpy()                                            # server-side
        m_norm = float(np.median(norms))
        ref = U.median(dim=0).values                                             # Δθ_ref
        info = {}
        for i, cid in enumerate(cids):
            t = teles[i]
            T = 1.0
            if use_trust:
                if c.use_T_lab:
                    T *= np.exp(-c.kappa_q * t["mu"])                                            # Eq. 34
                if c.use_T_val:
                    T *= t["z"] * t["acc"] * np.exp(-c.kappa_l * t["loss"]) if np.isfinite(t["loss"]) else 0.0  # Eq. 35
                if c.use_T_mag:
                    T *= np.exp(-c.kappa_m * abs(norms[i] - m_norm) / (m_norm + c.eps)) * (1 - c.lambda_c * t["clip"])  # Eq. 36
                if c.use_T_dir:
                    d_i = float(U[i] @ ref / (U[i].norm() * ref.norm() + c.eps))                  # Eq. 37
                    T *= max(0.0, (1 + d_i) / 2)                                                  # Eq. 38
                self.R[cid] = c.lambda_R * self.R[cid] + (1 - c.lambda_R) * T                   # Eq. 40
            info[cid] = dict(T=T, R=self.R[cid], mu=t["mu"])
        raw = np.array([teles[i]["n"] ** c.size_power * self.R[cid] for i, cid in enumerate(cids)])
        if raw.sum() <= c.eps:
            return theta_g, info
        beta = torch.as_tensor(raw / (raw.sum() + c.eps))                       # Eq. 41
        return unflat(flat(theta_g).double() + (beta[:, None] * U).sum(0), theta_g), info  # Eq. 42


def robust_f(cfg):
    return cfg.robust_f if cfg.robust_f is not None else int(round(cfg.n_clients * cfg.malicious_frac))


def aggregate_baseline(theta_g, deltas, ns, method, cfg):
    U = torch.stack([flat(d) for d in deltas])
    M, f = U.shape[0], robust_f(cfg)
    if method == "fedavg":
        w = torch.as_tensor(np.asarray(ns, dtype=np.float64) / np.sum(ns), dtype=torch.float32)
        agg = (w[:, None] * U).sum(0)
    elif method == "trimmed_mean":
        k = min(f, (M - 1) // 2)
        agg = U.sort(dim=0).values[k:M - k].mean(0)
    elif method == "krum":
        f = min(f, max(0, (M - 3) // 2))
        D = torch.cdist(U, U) ** 2
        scores = torch.sort(D, dim=1).values[:, 1:M - f - 1].sum(1)
        agg = U[int(scores.argmin())]
    else:
        raise ValueError(method)
    return unflat(flat(theta_g) + agg, theta_g)
## Step 8 — Metrics from one confusion matrix (R1-1)

Attack = positive class. Every metric comes from the same TP / TN / FP / FN counts:
Accuracy = (TP+TN)/N, Precision = TP/(TP+FP), Recall = TP/(TP+FN), F1 = 2PR/(P+R),
FPR = FP/(FP+TN). Binary (positive-class) definitions, no macro/weighted averaging.
def confusion_counts(y_true, y_pred):
    return dict(tp=int(((y_pred == 1) & (y_true == 1)).sum()), tn=int(((y_pred == 0) & (y_true == 0)).sum()),
                fp=int(((y_pred == 1) & (y_true == 0)).sum()), fn=int(((y_pred == 0) & (y_true == 1)).sum()))


def metrics_from_counts(tp, tn, fp, fn):
    n = tp + tn + fp + fn
    prec = tp / (tp + fp) if tp + fp else 0.0
    rec = tp / (tp + fn) if tp + fn else 0.0
    return dict(accuracy=100 * (tp + tn) / n, precision=100 * prec, recall=100 * rec,
                f1=100 * (2 * prec * rec / (prec + rec) if prec + rec else 0.0),
                fpr=100 * (fp / (fp + tn) if fp + tn else 0.0))


def evaluate(model, X, y, device):
    pred = predict_logits(model, X, device).argmax(1).numpy()
    cm = confusion_counts(y, pred)
    return {**metrics_from_counts(**cm), **cm}
## Step 9 — Clients, partitioning, and the FL loop
def partition_indices(y, cfg, rng, min_size=None):
    n, N = len(y), cfg.n_clients
    if cfg.partition == "iid":
        return [np.sort(s) for s in np.array_split(rng.permutation(n), N)]
    if min_size is None:           # 20 samples for real datasets, smaller for tiny debug data
        min_size = max(2, min(20, n // (20 * N)))
    for _ in range(5000):          # Dirichlet(α) over each class; redraw until no client is tiny
        parts = [[] for _ in range(N)]
        for c in np.unique(y):
            idx = rng.permutation(np.where(y == c)[0])
            props = rng.dirichlet(np.repeat(cfg.dirichlet_alpha, N))
            for i, chunk in enumerate(np.split(idx, (np.cumsum(props) * len(idx)).astype(int)[:-1])):
                parts[i].extend(chunk.tolist())
        if min(len(p) for p in parts) >= min_size:
            return [np.array(sorted(p)) for p in parts]
    raise RuntimeError("Could not draw a Dirichlet partition with non-empty clients; increase alpha.")


def make_clients(y_train, cfg, seed, attack):
    """Same seed → same partition, local splits and malicious set (used by the run and the report)."""
    rng = np.random.default_rng(seed)
    parts = partition_indices(y_train, cfg, rng)
    splits = []
    for p in parts:
        p = rng.permutation(p)
        n_val = max(1, int(round(cfg.client_val_frac * len(p))))
        splits.append((p[n_val:], p[:n_val]))
    n_mal = int(round(cfg.n_clients * cfg.malicious_frac)) if attack != "none" else 0
    if n_mal == 0:
        mal = set()
    elif cfg.malicious_selection == "random":
        mal = set(rng.choice(cfg.n_clients, n_mal, replace=False).tolist())
    else:
        counts = np.array([int((y_train[tr] == 1).sum()) for tr, _ in splits])
        mal = set(np.argsort(-counts, kind="stable")[:n_mal].tolist())
    return splits, mal, rng


def describe_clients(ds, cfg, seed, setting, attack="ca_lfa"):
    """Per-client sample/class counts + one heterogeneity number (R1-3, R2-Q1, R3-4).
    Heterogeneity = mean total-variation distance between each client's class distribution and
    the global one (0 = IID, 0.5 = maximally skewed for a balanced binary problem)."""
    y = ds["y_train"]
    splits, mal, _ = make_clients(y, cfg, seed, attack)
    g = np.array([np.mean(y == 0), np.mean(y == 1)])
    rows = []
    for cid, (tr, va) in enumerate(splits):
        yy = y[np.concatenate([tr, va])]
        p = np.array([np.mean(yy == 0), np.mean(yy == 1)])
        rows.append(dict(client=cid, n=len(yy), normal=int((yy == 0).sum()), attack=int((yy == 1).sum()),
                         attack_ratio=round(float(p[1]), 4), malicious=cid in mal,
                         tv_distance=round(float(0.5 * np.abs(p - g).sum()), 4)))
    df = pd.DataFrame(rows)
    df.to_csv(f"results/client_distribution_{ds['name']}_{setting}_seed{seed}.csv", index=False)
    return df, float(df["tv_distance"].mean())


def run_experiment(ds, exp, cfg, seed, device, verbose=True):
    set_seed(seed)
    kind, defence, attack, rho = exp["model"], exp["defence"], exp["attack"], exp["rho"]
    Xs = "T" if kind == "tinybert" else "X"
    X_train, X_test = ds[f"{Xs}_train"], ds[f"{Xs}_test"]
    y_train, y_test = ds["y_train"], ds["y_test"]
    splits, mal, rng = make_clients(y_train, cfg, seed, attack)
    n_mal = len(mal)

    rlfa_cache = {}
    if attack == "rlfa":
        for cid in sorted(mal):
            tr, va = splits[cid]
            rlfa_cache[cid] = (rlfa_flip(y_train[tr], rho, rng, cfg.rlfa_mode),
                               rlfa_flip(y_train[va], rho, rng, cfg.rlfa_mode))

    model = make_model(kind, ds["n_features"], cfg, device)
    theta = get_trainable(model)
    server = AgentGuardServer(cfg.n_clients, cfg) if defence == "agentguard" else None
    z_alie = cfg.alie_z if cfg.alie_z is not None else alie_z(cfg.n_clients, n_mal)
    if verbose:
        print(f"  {ds['name']} | {exp['group']} | {exp['method']} | {ATTACK_NAMES[attack]} rate={exp['rate']} "
              f"[{exp['setting']}] seed={seed} | malicious={sorted(mal)} | params={flat(theta).numel():,}")

    history, t0 = [], time.time()
    for rnd in range(1, cfg.n_rounds + 1):
        active = attack if rnd > cfg.warmup_rounds else "none"
        deltas, teles, ns, flips = [], [], [], 0
        for cid, (tr, va) in enumerate(splits):
            d, t, n_i, nf = client_round(
                model, theta, X_train[tr], y_train[tr], X_train[va], y_train[va],
                defence=defence, is_mal=(cid in mal and active != "none"), attack=active, rho=rho,
                rlfa_labels=rlfa_cache.get(cid), cfg=cfg, device=device, rng=rng, rnd=rnd)
            deltas.append(d); teles.append(t); ns.append(n_i); flips += nf

        if active == "alie" and mal:                          # ALIE: replace the attackers' updates
            src = sorted(mal) if cfg.alie_knowledge == "partial" else [i for i in range(cfg.n_clients) if i not in mal]
            S = torch.stack([flat(deltas[i]) for i in src])
            sd = S.std(dim=0) if len(src) > 1 else torch.zeros_like(S[0])
            crafted = unflat(S.mean(dim=0) - z_alie * sd, theta)
            for i in mal:
                deltas[i] = {k: v.clone() for k, v in crafted.items()}
                if teles[i] is not None:
                    teles[i]["clip"] = int(flat(crafted).norm().item() > cfg.tau)

        if defence == "agentguard" and cfg.attacker_forges_telemetry and active != "none":
            for i in mal:                                     # attacker reports perfect telemetry
                teles[i].update(acc=1.0, loss=0.01, z=1, clip=0, mu=0.0)

        info = {}
        if defence == "agentguard":
            theta, info = server.aggregate(theta, list(range(cfg.n_clients)), deltas, teles, rnd=rnd)
        else:
            theta = aggregate_baseline(theta, deltas, ns, defence, cfg)
        set_trainable(model, theta)
        m = evaluate(model, X_test, y_test, device)

        def _mean(key, group):
            v = [info[c][key] for c in info if (c in mal) == group]
            return float(np.mean(v)) if v else np.nan

        history.append(dict(round=rnd, n_malicious=n_mal, n_flipped=flips,
                            trust_mal=_mean("T", True), trust_ben=_mean("T", False),
                            rep_mal=_mean("R", True), rep_ben=_mean("R", False),
                            mu_mal=_mean("mu", True), mu_ben=_mean("mu", False), **m))
        if verbose and (rnd == 1 or rnd % 10 == 0 or rnd == cfg.n_rounds):
            print(f"    round {rnd:>3}: acc={m['accuracy']:.2f} P={m['precision']:.2f} R={m['recall']:.2f} "
                  f"F1={m['f1']:.2f} FPR={m['fpr']:.2f} | TP={m['tp']} FN={m['fn']} FP={m['fp']} TN={m['tn']}")
    if verbose:
        print(f"    done in {time.time() - t0:.0f}s")
    return history
## Step 10 — Experiment plan

Groups (switch each on/off and choose datasets in `RUN_GROUPS`):
* **main** — AgentGuard-FL, FedAvg, Krum, Trimmed Mean × {no attack, CA-LFA, RLFA, ALIE}.
* **models** — FedRNN / FedCNN / FedLSTM × {CA-LFA, RLFA, ALIE} (Table III with all metrics).
* **ablation** — AgentGuard-FL with one component removed, under CA-LFA and ALIE.
* **backbone** — random frozen BERT / BERT from scratch / MLP inside AgentGuard-FL.
* **heterogeneity** — IID and Dirichlet α ∈ {1.0, 0.5, 0.1}.
* **sensitivity** — κ_q, λ_R, γ_q, τ sweeps.
* **forged** — AgentGuard-FL when attackers forge their telemetry.

**Attack rate.** With `ATTACK_RATE_MEANS = "flip_ratio"`, 40% of clients are malicious and the
rate is ρ. ALIE has no ρ, so it runs once with 40% malicious clients (rate column = 0.40).
With `"malicious_frac"`, the rate is the fraction of malicious clients (ρ = `FIXED_FLIP_RATIO`).

Runs that are identical (e.g. the main AgentGuard-FL run and the α = 0.1 heterogeneity run) are
computed once and reused.
ATTACK_RATES = [0.25, 0.35]
ATTACK_RATE_MEANS = "flip_ratio"
FIXED_FLIP_RATIO = 1.0
SEEDS = [42, 43, 44]              # mean ± std and 95% CI over seeds
SWEEP_RATE = 0.35                 # rate used by the heterogeneity / sensitivity sweeps

# "all" = every dataset, "first" = first dataset only, False = skip
RUN_GROUPS = dict(main="all", models="all", ablation="all", backbone="all",
                  heterogeneity="first", sensitivity="first", forged="all")

MAIN_METHODS = [("AgentGuard-FL", "tinybert", "agentguard"), ("FedAvg", "tinybert", "fedavg"),
                ("Krum", "tinybert", "krum"), ("Trimmed Mean", "tinybert", "trimmed_mean")]
LF_ATTACKS = ["ca_lfa", "rlfa"]


def E(group, method, model, defence, attack, rate, setting="default", **overrides):
    return dict(group=group, method=method, model=model, defence=defence, attack=attack,
                rate=rate, setting=setting, overrides=overrides)


def alie_rates():
    return [CFG.malicious_frac] if ATTACK_RATE_MEANS == "flip_ratio" else ATTACK_RATES


def build_grid():
    g = []
    for m in MAIN_METHODS:
        g.append(E("main", *m, "none", 0.0))
        for r in ATTACK_RATES:
            for a in LF_ATTACKS:
                g.append(E("main", *m, a, r))
        for r in alie_rates():
            g.append(E("main", *m, "alie", r))

    for kind, name in [("rnn", "FedRNN"), ("cnn", "FedCNN"), ("lstm", "FedLSTM")]:
        for r in ATTACK_RATES:
            for a in LF_ATTACKS:
                g.append(E("models", name, kind, "fedavg", a, r))
        for r in alie_rates():
            g.append(E("models", name, kind, "fedavg", "alie", r))

    ablations = [("w/o reliability weighting", dict(use_reliability=False)),
                 ("w/o update clipping", dict(use_clipping=False)),
                 ("w/o client agent (reliability + clipping)", dict(use_reliability=False, use_clipping=False)),
                 ("w/o label trust T_lab", dict(use_T_lab=False)),
                 ("w/o validation trust T_val", dict(use_T_val=False)),
                 ("w/o magnitude trust T_mag", dict(use_T_mag=False)),
                 ("w/o direction trust T_dir", dict(use_T_dir=False)),
                 ("w/o reputation (λ_R = 0)", dict(lambda_R=0.0)),
                 ("w/o server trust (all T)", dict(use_trust=False))]
    for name, ov in [("AgentGuard-FL (full)", {})] + ablations:
        for r in ATTACK_RATES:
            g.append(E("ablation", name, "tinybert", "agentguard", "ca_lfa", r, **ov))
        for r in alie_rates():
            g.append(E("ablation", name, "tinybert", "agentguard", "alie", r, **ov))

    for name, kind, ov in [("Pretrained frozen BERT-Tiny (proposed)", "tinybert", {}),
                           ("Random frozen BERT-Tiny", "tinybert", dict(backbone_mode="random_frozen")),
                           ("BERT-Tiny trained from scratch", "tinybert", dict(backbone_mode="scratch_trainable")),
                           ("MLP", "mlp", {})]:
        g.append(E("backbone", name, kind, "agentguard", "none", 0.0, **ov))
        for r in ATTACK_RATES:
            g.append(E("backbone", name, kind, "agentguard", "ca_lfa", r, **ov))

    for setting, ov in [("IID", dict(partition="iid")), ("alpha=1.0", dict(dirichlet_alpha=1.0)),
                        ("alpha=0.5", dict(dirichlet_alpha=0.5)), ("alpha=0.1", dict(dirichlet_alpha=0.1))]:
        for m in MAIN_METHODS:
            g.append(E("heterogeneity", *m, "none", 0.0, setting, **ov))
            g.append(E("heterogeneity", *m, "ca_lfa", SWEEP_RATE, setting, **ov))

    for p, vals in [("kappa_q", [2.0, 4.0, 8.0, 16.0]), ("lambda_R", [0.0, 0.2, 0.5, 0.8]),
                    ("gamma_q", [0.2, 0.3, 0.4, 0.5]), ("tau", [0.5, 1.0, 2.0, 4.0])]:
        for v in vals:
            g.append(E("sensitivity", "AgentGuard-FL", "tinybert", "agentguard", "ca_lfa", SWEEP_RATE,
                       f"{p}={v}", **{p: v}))

    for r in ATTACK_RATES:
        g.append(E("forged", "AgentGuard-FL (forged telemetry)", "tinybert", "agentguard", "ca_lfa", r,
                   attacker_forges_telemetry=True))
    for r in alie_rates():
        g.append(E("forged", "AgentGuard-FL (forged telemetry)", "tinybert", "agentguard", "alie", r,
                   attacker_forges_telemetry=True))
    return g


def exp_config(exp):
    cfg = replace(CFG, **exp["overrides"])
    if exp["attack"] == "alie":
        exp["rho"] = 0.0
        if ATTACK_RATE_MEANS == "malicious_frac":
            cfg = replace(cfg, malicious_frac=exp["rate"])
    elif ATTACK_RATE_MEANS == "flip_ratio":
        exp["rho"] = exp["rate"]
    else:
        exp["rho"] = FIXED_FLIP_RATIO
        if exp["attack"] != "none":
            cfg = replace(cfg, malicious_frac=exp["rate"])
    return cfg


def datasets_for(group):
    sel = RUN_GROUPS.get(group, False)
    return [] if not sel else (DATASETS if sel == "all" else DATASETS[:1])


def run_id(ds_name, exp, cfg, seed):
    key = dict(ds=ds_name, model=exp["model"], defence=exp["defence"], attack=exp["attack"],
               rho=exp["rho"], seed=seed, cfg=asdict(cfg))
    return hashlib.md5(json.dumps(key, sort_keys=True, default=str).encode()).hexdigest()[:12]


GRID = build_grid()
PLAN = []
for ds in DATASETS:
    for exp in GRID:
        if ds not in datasets_for(exp["group"]):
            continue
        e = dict(exp)
        cfg = exp_config(e)
        for seed in SEEDS:
            PLAN.append((ds, e, cfg, seed, run_id(ds["name"], e, cfg, seed)))
print(f"{len(PLAN)} planned runs, {len({p[4] for p in PLAN})} unique "
      f"(groups: {', '.join(k for k, v in RUN_GROUPS.items() if v)})")
### Client data distribution (report in Sec. IV-A)
