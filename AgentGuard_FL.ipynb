def summarise(df, by):
    rows = []
    for key, g in df.groupby(by, sort=False):
        row = dict(zip(by, key if isinstance(key, tuple) else (key,)))
        k = len(g)
        for m in METRICS:
            mu, sd = g[m].mean(), g[m].std(ddof=1) if k > 1 else 0.0
            ci = _student_t.ppf(0.975, k - 1) * sd / np.sqrt(k) if k > 1 else 0.0
            row[m] = f"{mu:.2f} ± {sd:.2f}" if k > 1 else f"{mu:.2f}"
            row[f"{m}_ci95"] = round(ci, 2)
        for c in COUNTS:
            row[c.upper()] = round(g[c].mean(), 1) if k > 1 else int(g[c].iloc[0])
        row["N+"] = int(g.tp.iloc[0] + g.fn.iloc[0])
        row["N-"] = int(g.fp.iloc[0] + g.tn.iloc[0])
        row["seeds"] = k
        rows.append(row)
    return pd.DataFrame(rows)


def save_table(df, name):
    df.to_csv(f"results/{name}.csv", index=False)
    try:
        cols = [c for c in df.columns if not c.endswith("_ci95")]
        with open(f"results/{name}.tex", "w") as fh:
            fh.write(df[cols].to_latex(index=False))
    except Exception:
        pass
    print(f"\n=== {name} ===")
    print(df[[c for c in df.columns if not c.endswith("_ci95")]].to_string(index=False))


