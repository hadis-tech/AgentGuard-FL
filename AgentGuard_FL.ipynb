## Step 12 — Figures: accuracy curves and confusion matrices

Method colours stay fixed across every figure (AgentGuard-FL blue, FedAvg orange, Krum aqua,
Trimmed Mean yellow) and each method also has its own marker, so the figures read in greyscale.
try:
    import matplotlib.pyplot as plt
    from matplotlib.ticker import MaxNLocator

    STYLE = {"AgentGuard-FL": ("#2a78d6", "o", "-"), "FedAvg": ("#eb6834", "s", "--"),
             "Krum": ("#1baf7a", "^", "-."), "Trimmed Mean": ("#eda100", "D", ":")}
    plt.rcParams.update({"axes.spines.top": False, "axes.spines.right": False, "axes.grid": True,
                         "grid.alpha": 0.25, "grid.linewidth": 0.6, "lines.linewidth": 2,
                         "font.size": 9, "axes.titlesize": 10})
    main = results[results["group"] == "main"]

    def safe(s):
        return str(s).replace(" ", "_").replace("/", "_")

    # Accuracy over rounds (Figs. 2–4), one panel per attack/rate, mean over seeds
    for ds_name in main["dataset"].unique():
        d = main[main["dataset"] == ds_name]
        combos = [(a, r) for a in ["ca_lfa", "rlfa", "alie"] for r in sorted(d[d.attack == a]["rate"].unique())]
        if not combos:
            continue
        fig, axes = plt.subplots(1, len(combos), figsize=(3.6 * len(combos), 3.4), sharey=True)
        axes = np.atleast_1d(axes)
        clean = d[(d.attack == "none") & (d.method == "AgentGuard-FL")].groupby("round")["accuracy"].mean()
        for ax, (a, r) in zip(axes, combos):
            for meth, (col, mk, ls) in STYLE.items():
                c = d[(d.attack == a) & (d.rate == r) & (d.method == meth)].groupby("round")["accuracy"].mean()
                if not c.empty:
                    ax.plot(c.index, c.values, color=col, marker=mk, ms=4, markevery=5, ls=ls, label=meth)
            if not clean.empty:
                ax.plot(clean.index, clean.values, color="#8a8a85", lw=1.2, ls=(0, (1, 2)), label="AgentGuard-FL, no attack")
            ax.set_title(f"{ATTACK_NAMES[a]} — rate {int(round(r * 100))}%")
            ax.set_xlabel("Communication round")
            ax.xaxis.set_major_locator(MaxNLocator(integer=True))
        axes[0].set_ylabel("Accuracy (%)")
        handles, labels = axes[0].get_legend_handles_labels()
        fig.legend(handles, labels, loc="lower center", ncol=len(labels), frameon=False, bbox_to_anchor=(0.5, -0.04))
        fig.suptitle(ds_name)
        fig.tight_layout(rect=(0, 0.06, 1, 1))
        fig.savefig(f"results/accuracy_{safe(ds_name)}.png", dpi=200, bbox_inches="tight")
        plt.show()

    # Confusion matrices: rows = true class, columns = predicted class; colour = row-normalised rate
    fm = final[final["group"] == "main"]
    for (ds_name, a, r), d in fm.groupby(["dataset", "attack", "rate"], sort=False):
        meths = [m for m in STYLE if m in set(d.method)]
        fig, axes = plt.subplots(1, len(meths), figsize=(2.9 * len(meths), 2.9))
        axes = np.atleast_1d(axes)
        for ax, meth in zip(axes, meths):
            g = d[d.method == meth]
            tp, fn, fp, tn = (g[c].mean() for c in COUNTS)
            M = np.array([[tn, fp], [fn, tp]])
            rates = M / M.sum(axis=1, keepdims=True)
            ax.imshow(rates, cmap="Blues", vmin=0, vmax=1)
            for (i, j), v in np.ndenumerate(M):
                name = [["TN", "FP"], ["FN", "TP"]][i][j]
                ax.text(j, i, f"{name}\n{v:,.0f}\n({100 * rates[i, j]:.1f}%)", ha="center", va="center",
                        fontsize=8, color="white" if rates[i, j] > 0.6 else "#1a1a19")
            ax.set_xticks([0, 1], ["Normal", "Attack"])
            ax.set_yticks([0, 1], ["Normal", "Attack"])
            ax.set_xlabel("Predicted")
            ax.grid(False)
            ax.set_title(meth)
        axes[0].set_ylabel("True")
        seeds_note = f"mean of {d.seed.nunique()} seeds" if d.seed.nunique() > 1 else f"seed {d.seed.iloc[0]}"
        fig.suptitle(f"{ds_name} — {ATTACK_NAMES[a]}" + (f", rate {int(round(r * 100))}%" if a != "none" else "")
                     + f" ({seeds_note})")
        fig.tight_layout()
        fig.savefig(f"results/cm_{safe(ds_name)}_{a}_{int(round(r * 100))}.png", dpi=200, bbox_inches="tight")
        plt.show()
except ImportError:
