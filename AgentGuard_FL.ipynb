def pick_device() -> str:
    if torch.cuda.is_available():
        return "cuda"
    # Apple-silicon GPU. The trainable part of the model is tiny, so CPU is often as fast.
    if getattr(torch.backends, "mps", None) is not None and torch.backends.mps.is_available():
        return "mps"
    return "cpu"


